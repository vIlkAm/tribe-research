# Copy to .env (git-ignored). These are for THIS project only; never reuse
# Clipping Cartel credentials here.
#
# RunPod API key: only needed if we later script pod start/stop. Pods are
# launched manually from the RunPod console for now.
RUNPOD_API_KEY=
# HuggingFace read token with access to meta-llama/Llama-3.2-3B (gated).
# Set it as a RunPod secret on the pod as HF_TOKEN; it is not needed on this server.
HF_TOKEN=
